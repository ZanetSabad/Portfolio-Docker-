RewriteEngine On

# pokud existuje skutečný soubor nebo složka, nepřepisuj
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# hezké URL
RewriteRule ^o-mne/?$ about-me.php [L,QSA]
RewriteRule ^zkusenosti/?$ experience.php [L,QSA]
RewriteRule ^skills/?$ skills.php [L,QSA]
RewriteRule ^projekty/?$ portfolio.php [L,QSA]
RewriteRule ^kontakt/?$ contact.php [L,QSA]
